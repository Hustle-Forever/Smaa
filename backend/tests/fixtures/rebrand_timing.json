{
  "about": "A pattern's time (elements/pattern.py timing) and its mirror (frontend/src/lib/rebrandTiming.ts) answer these alike. Each case: the element's animation (recipe JSON), the scene's length, the entrance the build resolved; expect = Timing.public() or null (it does not show); phases = [t, phase, q]. Read by tests/test_rebrand_harness_recipe.py and frontend/scripts/check-rebrand-timing.mjs.",
  "cases": [
    {"name": "no time set: today's (in over 1 s from 0, held to the end, no exit)",
     "animation": {}, "duration": 8.0, "entrance": "left_to_right",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 8.0, "t_out": 8.0,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true},
     "phases": [[0.0, "in", 0.0], [0.5, "in", 0.5], [1.0, "hold", 1.0], [7.9, "hold", 1.0], [8.0, "after", 1.0]]},
    {"name": "the trimmed 815 scene (7.8 s)",
     "animation": {"entrance": "auto"}, "duration": 7.8, "entrance": "left_to_right",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 7.8, "t_out": 7.8,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true}},
    {"name": "no entrance: there from the first frame",
     "animation": {"entrance": "none"}, "duration": 8.0, "entrance": "none",
     "expect": {"t_in": 0.0, "t_full": 0.0, "t_hold_end": 8.0, "t_out": 8.0,
                "entrance": "none", "exit": "none", "runs_to_end": true},
     "phases": [[0.0, "hold", 1.0]]},
    {"name": "a late start that runs to the end: auto exit is none",
     "animation": {"start": {"mode": "at_sec", "sec": 2.0}}, "duration": 8.0, "entrance": "left_to_right",
     "expect": {"t_in": 2.0, "t_full": 3.0, "t_hold_end": 8.0, "t_out": 8.0,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true},
     "phases": [[1.9, "before", 0.0], [2.5, "in", 0.5], [3.0, "hold", 1.0]]},
    {"name": "an exit chosen on a pattern that runs to the end is played before the cut",
     "animation": {"exit": "fade", "exit_sec": 0.6}, "duration": 8.0, "entrance": "left_to_right",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 7.4, "t_out": 8.0,
                "entrance": "left_to_right", "exit": "fade", "runs_to_end": true},
     "phases": [[7.4, "out", 0.0], [7.7, "out", 0.5]]},
    {"name": "ends early: auto exit = the entrance played backwards (left strip goes back left)",
     "animation": {"end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0, "entrance": "left_to_right",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "left_to_right", "exit": "to_left", "runs_to_end": false},
     "phases": [[3.4, "out", 0.0], [3.7, "out", 0.5], [4.0, "after", 1.0], [5.0, "after", 1.0]]},
    {"name": "right_to_left goes to_right",
     "animation": {"end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0, "entrance": "right_to_left",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "right_to_left", "exit": "to_right", "runs_to_end": false}},
    {"name": "top_to_bottom goes to_top",
     "animation": {"end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0, "entrance": "top_to_bottom",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "top_to_bottom", "exit": "to_top", "runs_to_end": false}},
    {"name": "bottom_to_top goes to_bottom",
     "animation": {"end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0, "entrance": "bottom_to_top",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "bottom_to_top", "exit": "to_bottom", "runs_to_end": false}},
    {"name": "glitch goes out glitching",
     "animation": {"end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0, "entrance": "glitch",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "glitch", "exit": "glitch", "runs_to_end": false}},
    {"name": "slide goes out sliding",
     "animation": {"entrance": "slide", "end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0,
     "entrance": "slide",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.4, "t_out": 4.0,
                "entrance": "slide", "exit": "slide_out", "runs_to_end": false}},
    {"name": "no entrance, ends early: auto exit is none (it holds to its end)",
     "animation": {"entrance": "none", "end": {"mode": "at_sec", "sec": 4.0}}, "duration": 8.0,
     "entrance": "none",
     "expect": {"t_in": 0.0, "t_full": 0.0, "t_hold_end": 4.0, "t_out": 4.0,
                "entrance": "none", "exit": "none", "runs_to_end": false},
     "phases": [[3.99, "hold", 1.0], [4.0, "after", 1.0]]},
    {"name": "a half-second span squeezes both ramps in proportion (0.3125 in, 0 hold, 0.1875 out)",
     "animation": {"start": {"mode": "at_sec", "sec": 1.0}, "end": {"mode": "at_sec", "sec": 1.5},
                   "duration_sec": 1.0, "exit_sec": 0.6},
     "duration": 8.0, "entrance": "fade",
     "expect": {"t_in": 1.0, "t_full": 1.3125, "t_hold_end": 1.3125, "t_out": 1.5,
                "entrance": "fade", "exit": "fade", "runs_to_end": false}},
    {"name": "a squeezed ramp keeps 0.1 s",
     "animation": {"start": {"mode": "at_sec", "sec": 2.0}, "end": {"mode": "at_sec", "sec": 2.5},
                   "duration_sec": 3.0, "exit_sec": 0.2},
     "duration": 8.0, "entrance": "fade",
     "expect": {"t_in": 2.0, "t_full": 2.4, "t_hold_end": 2.4, "t_out": 2.5,
                "entrance": "fade", "exit": "fade", "runs_to_end": false}},
    {"name": "Blueprint as a transition: 0-1.5 s, 0.3 s in, 0.5 s out",
     "animation": {"entrance": "fade", "end": {"mode": "at_sec", "sec": 1.5}, "duration_sec": 0.3,
                   "exit": "fade", "exit_sec": 0.5},
     "duration": 8.0, "entrance": "fade",
     "expect": {"t_in": 0.0, "t_full": 0.3, "t_hold_end": 1.0, "t_out": 1.5,
                "entrance": "fade", "exit": "fade", "runs_to_end": false},
     "phases": [[0.0, "in", 0.0], [0.15, "in", 0.5], [0.3, "hold", 1.0], [1.0, "out", 0.0], [1.25, "out", 0.5],
                [1.5, "after", 1.0]]},
    {"name": "an end past a shorter scene is clamped to it (and so runs to the end)",
     "animation": {"start": {"mode": "at_sec", "sec": 1.0}, "end": {"mode": "at_sec", "sec": 6.0}},
     "duration": 4.0, "entrance": "left_to_right",
     "expect": {"t_in": 1.0, "t_full": 2.0, "t_hold_end": 4.0, "t_out": 4.0,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true}},
    {"name": "an end exactly at the scene's end runs to the end",
     "animation": {"end": {"mode": "at_sec", "sec": 8.0}}, "duration": 8.0, "entrance": "left_to_right",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 8.0, "t_out": 8.0,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true}},
    {"name": "a shorter scene cuts the span below half a second: it keeps its end and starts earlier",
     "animation": {"start": {"mode": "at_sec", "sec": 3.8}}, "duration": 4.0, "entrance": "left_to_right",
     "expect": {"t_in": 3.5, "t_full": 4.0, "t_hold_end": 4.0, "t_out": 4.0,
                "entrance": "left_to_right", "exit": "none", "runs_to_end": true}},
    {"name": "a start at the scene's end: it does not show",
     "animation": {"start": {"mode": "at_sec", "sec": 4.0}}, "duration": 4.0, "entrance": "left_to_right",
     "expect": null},
    {"name": "a start past the scene's end: it does not show",
     "animation": {"start": {"mode": "at_sec", "sec": 5.0}, "end": {"mode": "at_sec", "sec": 6.0}},
     "duration": 4.0, "entrance": "fade",
     "expect": null},
    {"name": "a ramp longer than RAMP_SEC is held to 3 s",
     "animation": {"duration_sec": 5.0}, "duration": 8.0, "entrance": "fade",
     "expect": {"t_in": 0.0, "t_full": 3.0, "t_hold_end": 8.0, "t_out": 8.0,
                "entrance": "fade", "exit": "none", "runs_to_end": true}},
    {"name": "an exit with no length set lasts EXIT_SEC (0.6 s)",
     "animation": {"start": {"mode": "at_sec", "sec": 2.0}, "end": {"mode": "at_sec", "sec": 5.0},
                   "exit": "to_bottom"},
     "duration": 8.0, "entrance": "top_to_bottom",
     "expect": {"t_in": 2.0, "t_full": 3.0, "t_hold_end": 4.4, "t_out": 5.0,
                "entrance": "top_to_bottom", "exit": "to_bottom", "runs_to_end": false}},
    {"name": "an exit of none holds to the end of its span",
     "animation": {"end": {"mode": "at_sec", "sec": 3.0}, "exit": "none", "exit_sec": 2.0},
     "duration": 8.0, "entrance": "glitch",
     "expect": {"t_in": 0.0, "t_full": 1.0, "t_hold_end": 3.0, "t_out": 3.0,
                "entrance": "glitch", "exit": "none", "runs_to_end": false}}
  ]
}
