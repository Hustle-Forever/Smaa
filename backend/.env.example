# =============================================================================
# 42 Abu Dhabi Archivist — backend secrets template
# =============================================================================
# Copy to backend/.env and fill in values. Don't commit the real .env.

# --- Supabase Postgres (use the session pooler for IPv4 networks) -----------
DB_HOST=aws-1-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<set me>
DB_SSLMODE=require
# Connection pool. The Supabase DB is SHARED across every machine that runs this
# backend (deployed server + each dev's localhost), so the pool sizes ADD UP
# against the project's Postgres `max_connections` ceiling. Size accordingly:
#   • Deployed server (handles real traffic + 11 background pollers): DB_POOL_MAX=18, DB_POOL_MIN=2
#   • Dev localhost (light use): keep DB_POOL_MAX=5 (or 10) to leave headroom.
# Check headroom in the Supabase SQL editor before raising:
#   SHOW max_connections;
#   SELECT count(*), state FROM pg_stat_activity GROUP BY state;
# A too-small pool under load surfaces as `psycopg_pool.PoolTimeout: couldn't
# get a connection after 30s` in the logs.
DB_POOL_MIN=1
DB_POOL_MAX=10
# Per-connection statement_timeout in milliseconds (0 disables). Caps how long a
# single query can hold a pooled connection, so one slow query (e.g. an
# un-indexed vector KNN scan) can't drain the pool. RAG queries degrade
# gracefully on timeout. 15s is generous for OLTP once vector ANN indexes exist.
DB_STATEMENT_TIMEOUT_MS=15000

# --- Supabase project metadata ----------------------------------------------
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ACCESS_TOKEN=<for MCP / management API>

# --- Scraper target ---------------------------------------------------------
TARGET_URL=https://42abudhabi.ae
TARGET_DOMAIN=42abudhabi.ae

# --- HTTP behavior ----------------------------------------------------------
USER_AGENT=ArchivistBot/0.2 (+contact: you@example.com)
REQUEST_TIMEOUT=20
RUN_CONCURRENCY_FETCH=4
RUN_CONCURRENCY_OPENAI=2

# --- OpenAI -----------------------------------------------------------------
# Who answers the language-model calls the older agents make (website and
# brand-document ingest, Instagram classifying, captions, campaign planning,
# poster prompts, talking-head scripts, transcripts, generated pictures):
#   vertex  -> Gemini on Vertex AI (the default; the OpenAI key is not needed)
#   openai  -> the OpenAI models below
LLM_PROVIDER=vertex
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_SYNTHESIS=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_MODEL_WHISPER=whisper-1
OPENAI_BUDGET_USD=10

# --- Video Editor AI media providers ----------------------------------------
# Optional. Empty = the feature degrades gracefully: the "Change voice" button
# returns a clear "needs key" message, and "Add music → generate" falls back to
# the in-library picker. Paste a key to enable the real provider, then RESTART
# the backend (these are read at process start, so hot-reload is not enough).
#
# ElevenLabs speech-to-speech (the "Change voice" feature):
ELEVENLABS_API_KEY=
# Optional overrides (sensible defaults used if omitted):
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
#
# Suno music generation (the "Add music → generate" path).
# NOTE: the gateway request/response contract is still UNVERIFIED — confirm the
# endpoint/payload/field names against your provider's docs before relying on
# it (see the TODO markers in app/services/media_providers.py).
SUNO_API_KEY=
# SUNO_API_BASE=   # gateway base URL if not the built-in default

# --- Seedance 2.5 via Higgsfield (General AI Video -> engine: Seedance) -----
# General AI Video can animate its still with Veo (the default, no key needed)
# or with Seedance. Only the Seedance engine needs these. Both values come from
# the Higgsfield console (API keys). Server-side only: never ship them to the
# browser. Restart the backend after adding them.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Rolling 30-day cap on Seedance spend (USD), summed per submission from the
# yas_seedance_spend table; jobs Higgsfield did not charge (failed, nsfw,
# canceled) are written off. A clip whose estimate would cross the line is
# refused before anything is paid. 0 = no cap.
SEEDANCE_BUDGET_USD=50

# --- Local storage paths ----------------------------------------------------
ASSET_ROOT=data/assets
FRAMES_ROOT=data/frames
BRAND_ROOT=data/brand
UPLOAD_ROOT=data/uploads

# --- Video processing caps --------------------------------------------------
MAX_VIDEO_DURATION_SEC=600
MAX_VIDEOS_PER_RUN=5
MAX_FRAMES_PER_VIDEO=30

# --- CLIP -------------------------------------------------------------------
USE_CLIP=true
CLIP_MODEL=clip-ViT-B-32

# --- Text chunking ----------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP=50

# --- FastAPI ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:4242,http://127.0.0.1:4242,http://localhost:3000
LOG_LEVEL=INFO

# --- Public-preview access gate (shared password) ---------------------------
# Set this BEFORE exposing the app publicly (e.g. via the Cloudflare tunnel) so
# visitors must enter a password before ANY paid OpenAI/Vertex call runs. One
# password unlocks the whole app — the UI lock screen AND the backend API. It's
# enforced by the backend (app/access.py), not just hidden in the UI, so it
# genuinely protects your tokens. Empty = gate OFF (local dev). Restart the
# backend after changing it.
APP_ACCESS_PASSWORD=

# --- Scheduler --------------------------------------------------------------
# In-process APScheduler. 5-field cron in UTC. Empty = disabled.
# Ships DISABLED: the crawler is manual-only (Brand -> Synthesizer -> Run).
# An unattended tick on a settled site fetches nothing but still runs a full
# brand synthesis, because the synthesize phase has no change gate -- gate it
# before you arm a cron here.
AUTO_CRAWL_CRON=
SCHEDULER_TIMEZONE=UTC

# --- Background workers -----------------------------------------------------
# Master switch for every background poller (Veo, compositions, campaigns,
# trend scans, Industry Signal, post reminders) and for the crawl cron above.
#
# SET THIS TO false ON A DEV MACHINE. The pollers are workers, not observers:
# they write rows, send reminder emails and spend model credits. Because
# localhost points at the production database, a laptop running run.py is a
# SECOND worker competing with the deployed server for the same rows, and only
# two of them claim work with FOR UPDATE SKIP LOCKED. The rest just do it
# twice: two Veo polls, two reminder emails, two billable generations.
#
# Defaults to true when unset, so a forgotten variable can never silently stop
# unattended work on the server. docker-compose.yml pins it to "true" in its
# environment block (which beats env_file), so copying a dev .env up to the
# server cannot disarm it.
POLLERS_ENABLED=false
# Competitor Instagram scans: the scan poller reads every active account once
# the last full scan is this many hours old (default 24). 0 = the Scan button
# only. Needs POLLERS_ENABLED.
TREND_AUTO_SCAN_HOURS=24

# --- Vertex AI / Veo / Gemini (Producer Agent) -----------------------------
# Auth via ADC: run `gcloud auth application-default login` once on this host.
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Veo 3.1 output goes to a GCS bucket you create:
#   gcloud storage buckets create gs://studio-veo-out --location=us-central1
VEO_OUTPUT_BUCKET=studio-veo-out
VEO_MODEL=veo-3.1-fast-generate-001
VEO_MODEL_PREMIUM=veo-3.1-generate-001
VEO_BUDGET_USD=10
VEO_MAX_DURATION_SEC=8
VEO_DEFAULT_ASPECT=16:9

VERTEX_GEMINI_MODEL=gemini-2.5-pro
VERTEX_GEMINI_FAST_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=gemini-embedding-001
VERTEX_EMBED_DIM=768
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image    # Nano Banana; or "imagen-3.0-generate-002"
# Max image requests sent to Vertex at once (per process). The image models
# have a tight per-minute quota; bursts of parallel variants trip
# 429 RESOURCE_EXHAUSTED. Lower this if you still see 429s, raise it after a
# Vertex quota increase. Default 2.
VERTEX_IMAGE_CONCURRENCY=2

# --- TH v2 "Rebrand" experiment: Gemini Omni Flash (video-to-video) --------
# Runs on Vertex with the project's own ADC/billing (no extra key) — Omni is
# `global`-only there and is published under the PREVIEW id, which is why the
# Vertex model name differs from the Gemini-API one. A GEMINI_API_KEY is only a
# fallback (paid tier; the free tier excludes Omni). ~$0.10/sec of 720p output.
# OMNI_MODEL_VERTEX=gemini-omni-1.1-flash-preview   # what Vertex accepts
# OMNI_MODEL=gemini-omni-1.1-flash                  # Gemini-API name
# OMNI_VERTEX_LOCATION=global        # global only — there is no regional host
# GEMINI_API_KEY=
# OMNI_PROVIDER=auto                 # auto | vertex | api_key
# OMNI_MODEL=gemini-omni-1.1-flash
# OMNI_VERTEX_LOCATION=global
# OMNI_RESOLUTION=720p               # 360p | 720p | 1080p | 4k
# OMNI_MAX_CONCURRENT=2
# OMNI_TIMEOUT_SEC=900

# --- Model gateway: quota resilience + Claude reasoning brain ---------------
# On RESOURCE_EXHAUSTED (429) in the primary region, every Gemini call instantly
# fails over to the next region below (no waiting). Global in-flight cap smooths
# bursts under the per-minute quota.
VERTEX_FALLBACK_LOCATIONS=us-east4,us-west1,europe-west4
VERTEX_MAX_CONCURRENCY=4
# Claude runs the agentic editor's reasoning, via Vertex on the SAME ADC (no
# extra key). Claude models are region-specific in Model Garden (us-east5 is
# the usual home). Enable Claude in Vertex Model Garden once for the project.
CLAUDE_VERTEX_REGION=us-east5
CLAUDE_MODEL=claude-opus-4-8
# Fallback ONLY if Claude isn't enabled on Vertex — direct Anthropic API key.
# Leave blank to use Claude-on-Vertex (the default, no key needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# The editor's agent brain. The gateway probes vertex-claude -> anthropic-claude
# -> gemini and uses the first that answers, so the editor stays agentic even
# with no Claude access. Inspect the live choice at
# GET /api/yas-producer/video-editor/ai/providers
# auto | vertex-claude | anthropic-claude | gemini
VE_AGENT_PROVIDER=auto
VE_AGENT_GEMINI_MODEL=gemini-2.5-pro
VE_AGENT_MAX_STEPS=24

# --- Remotion compose service ---------------------------------------------
REMOTION_BASE_URL=http://127.0.0.1:3001
REMOTION_DEFAULT_CROSSFADE_SEC=0.5

# --- Composition-poller instance id (SHARED-DB SAFETY) ----------------------
# The Supabase Postgres is SHARED across all deployments (your local Docker,
# the production VPS, every teammate), but rendered media + the Remotion sidecar
# are LOCAL to each machine. Each instance's video-export poller therefore only
# touches renders it OWNS, keyed by this id. It MUST be UNIQUE per running
# backend — if two machines share a value, their pollers fight and finalise
# renders fail with "render job lost" / "no clip sources".
#   - Pick anything unique & stable: local-<yourname>, prod, ci, etc.
#   - If you leave it blank, it falls back to the container/host name (unique,
#     but changes whenever the container is recreated).
STUDIO_INSTANCE_ID=local-changeme

# Local cache for downloaded Veo MP4s (relative to backend/)
PRODUCER_ROOT=data/producer

# --- Instagram ingest (Agent 5) --------------------------------------------
# Token MUST be a long-lived Facebook User access token (starts with "EAA").
# Short-lived tokens 401 after ~1h. Exchange the short-lived one via:
#   curl -s "https://graph.facebook.com/v21.0/oauth/access_token?\
#     grant_type=fb_exchange_token&client_id=<APP_ID>&\
#     client_secret=<APP_SECRET>&fb_exchange_token=<SHORT_TOKEN>"
# NOTE: grant_type=ig_exchange_token (what this file used to say) is the
# Instagram-Login flow and is WRONG for an EAA Facebook User token — it fails
# with OAuthException. App id + secret come from developers.facebook.com →
# your App → Settings → Basic; they are not stored in this repo.
# Then, to stop the 60-day rot for good: call GET /me/accounts with the
# long-lived user token and use the linked Page's token instead — a Page token
# derived from a long-lived user token does not expire.
# Use the token of a Business / Creator IG account you control — the agent
# reads OTHER accounts via the Business Discovery edge, so this is just the
# requester identity. INSTAGRAM_ACCOUNT_ID is the IG Business Account ID
# attached to that token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Public IG handle to ingest (no @). Default targets 42 Abu Dhabi.
INSTAGRAM_TARGET_USERNAME=42abudhabi
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_ROOT=data/instagram
# Override for the shared video phase's MAX_VIDEOS_PER_RUN cap (default 5).
# IG backfills hundreds of reels; this cap drains the queue in one run.
INSTAGRAM_MAX_VIDEOS_PER_RUN=100

# --- General trends (Trends page → "General trends" tab) --------------------
# All optional — every value below already has a sane default in config.py, so
# an empty section is a working section. Free public sources, no keys, except
# YouTube (a free API key), TikTok (no key, but see the note) and the two
# Instagram lanes (the app's existing Graph token).
#
# ---------------------------------------------------------------------------
# THE WHOLE STREAM IS PAUSED. Default false, and every setting below it is inert
# until it is true: the poller does not start, "Refresh now" answers 423, and
# the social-listening report is built from the other two streams alone.
#
# Why: the feed surfaces things that HAPPENED rather than formats people are
# RECREATING, which is a research problem in source selection, not a bug with a
# patch. Nothing is deleted — collectors, tables and stored rows all stay.
#
# Turning it back on takes BOTH halves: this variable (then restart the
# backend), and VIRAL_SOCIAL_TRENDS_ENABLED in
# frontend/src/components/trends/featureFlags.ts (then rebuild the frontend).
# A static build cannot read this file, so neither half can imply the other.
#
# IF YOU TURN THIS ON LOCALLY, ten tests in tests/test_general_trends_paused.py
# will fail, and they are not broken. That file asserts the paused world
# against the module's REAL configured state, and config.py reads this .env, so
# switching the stream on genuinely contradicts it. Confirmed both ways:
#   GENERAL_TRENDS_ENABLED=false pytest tests/test_general_trends_paused.py  ->  15 passed
#   GENERAL_TRENDS_ENABLED=true  pytest tests/test_general_trends_paused.py  ->  10 failed
# CI has no .env at all, so it takes the false default and stays green. Run the
# suite with the variable forced off if you want a clean local run.
GENERAL_TRENDS_ENABLED=false
# ---------------------------------------------------------------------------
#
# Sources fetched every refresh (comma list). Known ids:
#   google_trends, bluesky, reddit, kym, wikipedia, youtube,
#   hacker_news, lemmy, github, google_news, tiktok, instagram,
#   instagram_watch, x_trends
# x_trends is deliberately NOT in the default list: it shipped bare hashtags
# with no summary and no counter, which the scoring model then had to invent a
# meaning for. The code is still there — add it back here to re-enable it.
GENERAL_TRENDS_SOURCES=google_trends,bluesky,reddit,kym,wikipedia,youtube,hacker_news,lemmy,github,google_news,tiktok,instagram,instagram_watch
# Regions for Google Trends geo / YouTube regionCode / X (trends24) slug.
# Known: US, AE, GB, IN, SA, EG. Bluesky/Reddit/KYM/Wikipedia are global.
GENERAL_TRENDS_GEOS=US,AE
# Subreddits read each refresh. 4, not 7: r/videos, r/OutOfTheLoop, r/popular
# and r/TikTokCringe were measured as mostly junk or ragebait, and anonymous
# Reddit allows roughly one request per minute per IP, so each extra sub costs
# a minute of the run.
GENERAL_TRENDS_SUBREDDITS=memes,ProgrammerHumor,Damnthatsinteresting,technology
# Auto-refresh cadence in hours (poller). 0 = manual "Refresh now" only.
GENERAL_TRENDS_REFRESH_HOURS=6
# Cap per (source, region) per refresh.
GENERAL_TRENDS_MAX_ITEMS_PER_SOURCE=40
# Per-source override of that cap: "source:n,source:n". Malformed pairs are
# ignored. Reddit is throttled down because it is corroboration, not a source
# of new cards; Know Your Meme is raised because it is the highest-precision
# feed we have (it ships a name AND a written explanation).
GENERAL_TRENDS_SOURCE_CAPS=reddit:15,kym:40,kym_entries:40,kym_editorials:10,youtube_shorts:15
# Feed window in days: how long ago a source may last have listed a trend for
# it to still show in the tab.
GENERAL_TRENDS_FEED_DAYS=7
# Content window in days: how old the NEWEST piece of evidence behind a card
# may be. This is the "nothing older than about a month" rule. A card first
# seen weeks ago but still collecting fresh sightings stays.
GENERAL_TRENDS_MAX_CONTENT_AGE_DAYS=30
# THE PARTICIPATION GATE. A trend is a format people are RECREATING, so the
# feed carries only these kinds. News, events and product launches are things
# that HAPPENED — nobody can make their own version — and are held back behind
# the tab's 'Show news too' toggle. Measured: of 363 trends in the first live
# corpus only 103 were a participatory kind. Empty = show every kind.
GENERAL_TRENDS_KINDS=meme,format,sound,challenge
# YouTube Charts' Shorts-usage chart ('songs used most by creators on Shorts')
# is the only GEO-CORRECT participatory source available — AE and US really do
# return different #1 tracks — and supplies most of the feed's `sound` kind.
# Keyless.
GENERAL_TRENDS_SHORTS_REGIONS=AE,SA,US
# Content screen applied at ingest, before anything is embedded or scored:
#   on         drop explicit/harmful items, flag dating bait and avoid-topics
#   flag_only  flag everything instead of dropping (use while tuning lists)
#   off        no screening at all
# Anything else falls back to "on" so a typo cannot switch it off.
GENERAL_TRENDS_SAFETY=on
# Comma list of terms the safety screen must never match — the same-day fix for
# a false positive without a deploy (e.g. "horny toad").
GENERAL_TRENDS_ALLOW_TERMS=
# true drops items whose source gave no publish time. Leave false: every source
# populates it today, so a sudden gap means a parser broke, and dropping would
# turn that into a silent source outage instead of a visible one.
GENERAL_TRENDS_DROP_UNDATED=false
# Gemini model for the AI scoring pass. Empty = the default Gemini model.
GENERAL_TRENDS_MODEL=
# Gemini model for the cheap label + triage pass over raw items (runs before
# clustering and before scoring). Empty = the fast Gemini model.
GENERAL_TRENDS_TRIAGE_MODEL=
# Look the trend up BEFORE recommending anything: one Google-grounded search per
# trend when you press "Make this". A hashtag is a LABEL, not a description —
# #spidermanbrandnewday is the title of a film, and read literally it produced
# three ideas about "a fresh start". Off falls back to the stored summary alone,
# which is a guess on roughly half of all hashtag trends.
GENERAL_TRENDS_RESEARCH=true
# How long one lookup stays good, in hours. 0 = never expires. Answers are
# cached on the trend row (metadata.research), so this is only paid once.
GENERAL_TRENDS_RESEARCH_TTL_HOURS=72
# YouTube Data API v3 key — free, no billing account, no card: console.cloud
# .google.com → enable "YouTube Data API v3" → Credentials → API key. The quota
# is 10,000 units/day and videos.list costs 1 unit, so the planned load is
# 8 units/day (4 refreshes x 2 regions). The source is silently skipped while
# this is empty, and it is the only remaining source carrying view/like/comment
# counts.
YOUTUBE_API_KEY=
# TikTok Creative Center hashtag regions (ISO-2, comma list). No key and no
# login, but it is a scrape of a server-rendered page: if it stops working the
# source reports an error rather than silently returning nothing. An
# unsupported region code silently returns US data, so stick to codes the
# Creative Center lists.
# Creative Center returns only THREE hashtags per (region, period) before the
# login wall, so region breadth is the ONLY lever on how many format
# candidates a run sees: 4 regions = 24, 8 = ~48, for ~12s of fetch.
# PH/ID/MY are here because of who lives in the UAE, not for coverage.
GENERAL_TRENDS_TIKTOK_REGIONS=AE,SA,EG,PH,ID,MY,US,GB
# Instagram hashtag roster (comma list, no '#'). Empty = the hashtag lane stays
# off. Needs instagram_manage_insights on INSTAGRAM_ACCESS_TOKEN. Graph caps
# UNIQUE hashtag NAMES at 30 per rolling 7 days (calls are unlimited), so treat
# this as a weekly decision and check
# GET /{ig-user-id}/recently_searched_hashtags before editing it. Leave ~5
# slots free for ad-hoc lookups.
GENERAL_TRENDS_IG_HASHTAGS=
# Public IG Business/Creator handles to watch (comma list, no '@') — accounts
# that SET trends, not competitors. One Business Discovery call each, no new
# scopes; works the moment the token is live. Empty = the lane stays off.
GENERAL_TRENDS_IG_WATCH_ACCOUNTS=

# === Producer Roadmap (Steps 4 Calendar + 5 Approval) =======================
# All optional. Unset = the roadmap still works: posts queue, the reminder
# email is skipped, and Approve & Post reports "not configured" instead of
# posting. Fill these in to enable real reminders + live publishing.

# Where you open 42 Studio (used in reminder-email links).
APP_BASE_URL=http://127.0.0.1:4242

# DEPRECATED — no longer needed. Media for calendar-booked posts is now copied
# to a PUBLIC Supabase Storage bucket (APPROVED_MEDIA_BUCKET below) at booking
# time, and Instagram fetches it from that permanent public URL. No tunnel /
# public base URL required. Left here only so old .env files don't error.
PUBLIC_MEDIA_BASE_URL=

# PUBLIC bucket that hosts calendar-booked media so Instagram can fetch it, in
# whichever store STORAGE_BACKEND picks (see "Media storage backend" below; on
# local disk there is no public URL, so Instagram publishing is off). Created
# automatically. Only assets you actually book in the roadmap calendar land
# here. Rename if you like.
APPROVED_MEDIA_BUCKET=approved-instagram

# Serve generated media (posters/animations) from a PUBLIC Supabase bucket so the
# Library loads straight from Supabase's CDN at permanent URLs + on-the-fly
# thumbnails (Pro plan) — the big "fast site" speedup. Leave 0/false to keep the
# private signed-URL proxy (still fast: signed URLs are now cached + media is
# immutable-cached by the browser). To turn ON: (1) make the PRODUCER_MEDIA_BUCKET
# bucket PUBLIC in the Supabase dashboard (a fresh project is created public
# automatically; an existing private bucket must be flipped by hand), then
# (2) set this to 1 and restart. If you flip it on while the bucket is still
# private, media URLs will 400. Supabase only: with STORAGE_BACKEND=s3 it is
# ignored and the bucket stays private (presigned URLs only).
PRODUCER_MEDIA_PUBLIC=0

# Supabase Image Transformation (/storage/v1/render/image/**) — a PAID add-on
# that serves resized WebP thumbnails on the fly (a 1.4 MB PNG comes back ~63 kB).
# On a project WITHOUT it, every such URL answers 403 FeatureNotEnabled. Those
# URLs go to the browser inside list JSON, so the backend never sees the failure
# and the Library, Dashboard and Assets grids all silently render
# "Preview unavailable" — which is exactly what happened (#37).
#   auto (default) — probe a real object once, cache the answer, re-check on a
#                    TTL so enabling the add-on later heals without a restart
#   on             — skip the probe and always transform
#   off            — skip the probe and never transform (correct for Free plan;
#                    thumbnails are then full-size objects: correct, but heavier)
# Supabase only: with STORAGE_BACKEND=s3 nothing is transformed on the fly and
# grids use the stored 480px thumbnails instead.
SUPABASE_IMAGE_TRANSFORM=auto

# --- Reminder email (SMTP). Empty SMTP_HOST = email is a logged no-op. ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<you@gmail.com>,
# SMTP_PASSWORD=<16-char App Password> (Google Account → Security → 2-Step
# Verification → App passwords; NOT your normal password).
REMINDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Instagram publishing (Approval step) ---
# OPTIONAL. If your INSTAGRAM_ACCESS_TOKEN above already has the
# instagram_content_publish permission (on a Business/Creator account), leave
# this EMPTY — publishing reuses that token + INSTAGRAM_ACCOUNT_ID and just
# works. Only set this if you want a SEPARATE token scoped for posting. Empty
# and no publish scope = self-gates (no accidental posts).
INSTAGRAM_PUBLISH_TOKEN=

# --- Industry Signal (Trends) ----------------------------------------------
# NO CREDENTIALS NEEDED, and NO VARIABLES EITHER. Every source is a public
# RSS/Atom feed or sitemap (OpenAI, Anthropic, the two Gemini blogs, plus
# tahawultech and one Google News lane for the UAE).
#
# There is deliberately nothing to set here. On/off is per source in the
# `news_sources` table (Trends -> Configure), the per-fetch caps and the
# keyword gate live in `news_settings`, and retention is RETENTION_DAYS in
# app/services/news_ingest.py. NEWS_ENABLED, NEWS_RETENTION_DAYS and
# NEWS_MAX_ITEMS_PER_FETCH used to sit here and were read by nothing.

# --- Media storage backend -------------------------------------------------
# Where uploads, renders and thumbnails are stored:
#   auto (default)  s3 when S3_ENDPOINT is set, else supabase when
#                   SUPABASE_SERVICE_ROLE_KEY is set, else local disk
#   s3              an S3-compatible store (the MinIO container on the AWS
#                   server, or AWS S3 itself), set by the S3_* lines below
#   supabase        Supabase Storage (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
#   local           files stay on this machine under data/ only
# An upload the store refuses falls back to local disk (logged as a warning).
# docker-compose.yml pins these for the server (s3 against its minio
# container), so a dev machine normally leaves the S3_* lines empty.
STORAGE_BACKEND=auto
# Endpoint the backend talks to and presigns against, e.g. http://minio:9000.
S3_ENDPOINT=
# What browsers get in place of S3_ENDPOINT in media URLs, e.g.
# https://api.42studio.fit/media. The proxy behind it must forward to
# S3_ENDPOINT with S3_ENDPOINT's host:port as the Host header (web/Caddyfile
# does), or every presigned URL fails its signature check.
S3_PUBLIC_BASE_URL=
# A least-privilege user, not the store's root account: the access key is
# visible in every presigned URL.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Must equal the store's region (MINIO_SITE_REGION on the server).
S3_REGION=us-east-1

# --- Assets Library (Agent 5 — v3 manual uploads) --------------------------
# Required to upload to the Supabase storage bucket. Without it (and with no
# S3_ENDPOINT above), uploads go to a local-disk folder (data/assets_library):
# still works, but files live only on this machine. Get it from Supabase
# dashboard → Project Settings → API → service_role (long JWT starting with eyJ...).
SUPABASE_SERVICE_ROLE_KEY=
PRODUCER_ASSETS_BUCKET=producer-assets
PRODUCER_ASSETS_ROOT=data/assets_library

# Required to bulk-import a Google Drive FOLDER (single-file Drive URLs work
# without it). Get a key from Google Cloud Console → APIs & Services →
# Credentials → Create API key. Enable the "Google Drive API" on the same
# project and restrict the key to that API only. The folder you paste must
# be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=

# --- Dev convenience -------------------------------------------------------
# When true, run.py uses uvicorn --reload so Python edits hot-reload (like
# Vite does for the frontend). Adds a ~2s restart per file save.
AUTO_RELOAD=false
