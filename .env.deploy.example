# =============================================================================
# 42 Studio — deploy-level config for docker compose (single EC2 host)
# =============================================================================
# Append to ./.env (repo root), on top of the app settings from
# backend/.env.example. Docker Compose auto-loads ./.env, substitutes these into
# docker-compose.yml, and passes the whole file to the backend. See
# docs/DEPLOY-AWS.md.

# Hostname Caddy serves + provisions HTTPS for. Its DNS A-record must point at
# the server's Elastic IP before the stack starts.
DOMAIN=api.42studio.fit

# Email Let's Encrypt uses for the certificate (expiry notices).
ACME_EMAIL=agegnew.mersha@gmail.com

# Canonical public origin of the app. Used by the backend for CORS + reminder-
# email links. The frontend calls the API same-origin at <PUBLIC_URL>/api.
PUBLIC_URL=https://api.42studio.fit
APP_BASE_URL=https://api.42studio.fit

# The postgres container is created with these, and the backend connects with
# the same values (compose pins DB_HOST=postgres). Hex password only
# (`openssl rand -hex 24`): app/db.py builds the DSN by string concatenation.
DB_NAME=studio
DB_USER=studio
DB_PASSWORD=
DB_POOL_MAX=18

# Media storage: the minio container (volume studio42_minio). Compose pins the
# rest (STORAGE_BACKEND=s3, S3_ENDPOINT, S3_PUBLIC_BASE_URL=<PUBLIC_URL>/media,
# S3_REGION), so only these four go here. Hex only, generated once:
#   MINIO_ROOT_USER      openssl rand -hex 8    (admin, used only by minio-init)
#   MINIO_ROOT_PASSWORD  openssl rand -hex 32
#   S3_ACCESS_KEY        openssl rand -hex 10   (the backend's own user; must
#   S3_SECRET_KEY        openssl rand -hex 32    differ from MINIO_ROOT_USER)
# The access key shows up in every presigned media URL, which is why the
# backend never uses the root account. minio-init applies a changed
# S3_SECRET_KEY on the next `docker compose up -d`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# No Supabase on this host. Leave both empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in. APP_ACCESS_PASSWORD arms the gate and signs the cookie
# (`openssl rand -hex 32`); APP_LOGIN_PASSWORD is what people type.
APP_ACCESS_PASSWORD=
APP_LOGIN_PASSWORD=

# Render ownership — exactly one server per database.
STUDIO_INSTANCE_ID=prod
